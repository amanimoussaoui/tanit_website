# https://openrouter.ai/ — clé API (ne pas committer le fichier .env)
OPENROUTER_API_KEY=

# Modèle OpenRouter (ex. openai/gpt-4o-mini, anthropic/claude-3.5-haiku, etc.)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optionnel : URL affichée côté OpenRouter (dashboard)
OPENROUTER_HTTP_REFERER=http://localhost:5174
