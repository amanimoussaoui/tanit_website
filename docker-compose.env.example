# Copier vers `.env` à la racine du dépôt (à côté de docker-compose.yml).
# Docker Compose charge automatiquement `.env` pour la substitution ${VAR}.
# Ne commitez pas `.env` (déjà dans .gitignore).

# --- Optionnel : OpenRouter (service fastapi dans compose) ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=http://localhost:5173

# --- Optionnel : e-mails backend (candidatures / décisions) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_DEBUG=
